+#requires -Version 7.2
+[CmdletBinding()]
+param([switch]$SkipBuild, [switch]$ProtocolOnly)
+$ErrorActionPreference = 'Stop'
+$Repository = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..\..\..'))
