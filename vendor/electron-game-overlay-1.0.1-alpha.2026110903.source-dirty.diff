diff --git a/libs/electron-game-overlay/src/lib/overlay-consumer-context.ts b/libs/electron-game-overlay/src/lib/overlay-consumer-context.ts
new file mode 100644
index 0000000000000000000000000000000000000000..664f65af8b180f68630b489db3270fad8da60783
--- /dev/null
+++ b/libs/electron-game-overlay/src/lib/overlay-consumer-context.ts
@@ -0,0 +1,108 @@
+import { execFile } from 'node:child_process';
+import { win32 as path } from 'node:path';
+import { createReShadeLaunchConfig, type ReShadeLaunchConfig } from './reshade-launcher.js';
+import { isValidProcessCreationTime100ns } from './overlay-process-identity.js';
+
+/** Current caller token and availability of a verified same-user medium desktop parent. */
+export type OverlayConsumerExecutionContext = Readonly<{
+  ownerPid: number;
+  creationTime100ns: string;
+  executablePath: string;
+  executableSha256: string;
+  elevated: boolean;
+  integrityRid: number;
+  sessionId: number;
+  overlaySupported: boolean;
+  relaunchAvailable: boolean;
+  relaunchRefusal: string | null;
+}>;
+/** Uses an already validated runtime configuration, or resolves the bundled native runtime. */
+export type OverlayConsumerContextOptions = Readonly<{ config?: ReShadeLaunchConfig }>;
+/** Own-executable replacement request. Arguments default to process.argv.slice(1), including a development app path. */
+export type OverlayConsumerRelaunchOptions = OverlayConsumerContextOptions & Readonly<{
+  context: OverlayConsumerExecutionContext;
+  arguments?: readonly string[];
+}>;
+/** Confirms kernel process/image/token creation, not Electron app readiness or overlay authentication. */
+export type OverlayConsumerRelaunchResult = Readonly<{
+  status: 'launched' | 'already-unelevated';
+  context: OverlayConsumerExecutionContext;
+  replacement?: Readonly<{ pid: number; creationTime100ns: string }>;
+}>;
+
+const normalize = (value: string) => {
+  const normalized=path.normalize(value), lower=normalized.toLowerCase();
+  return (lower.startsWith('\\\\?\\unc\\')?'\\\\'+normalized.slice(8):lower.startsWith('\\\\?\\')?normalized.slice(4):normalized).toLowerCase();
+};
+const expectedKeys = ['schemaVersion','kind','ownerPid','creationTime100ns','executablePath','executableSha256','elevated','integrityRid','sessionId','overlaySupported','relaunchAvailable','relaunchRefusal','status','replacementPid','replacementCreationTime100ns'];
+function validate(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Invalid native consumer context');
+  const result = value as Record<string, unknown>;
+  if (Object.keys(result).length !== expectedKeys.length || expectedKeys.some(key => !(key in result)) ||
+      result.schemaVersion !== 1 || result.kind !== 'electron-game-overlay-consumer-context' || result.ownerPid !== process.pid ||
+      !isValidProcessCreationTime100ns(result.creationTime100ns) || typeof result.executablePath !== 'string' ||
+      normalize(result.executablePath) !== normalize(process.execPath) || typeof result.executableSha256 !== 'string' || !/^[A-F0-9]{64}$/u.test(result.executableSha256) ||
+      typeof result.elevated !== 'boolean' || !Number.isSafeInteger(result.integrityRid) || Number(result.integrityRid)<0 || Number(result.integrityRid)>0xffffffff ||
+      !Number.isSafeInteger(result.sessionId) || Number(result.sessionId)<0 || Number(result.sessionId)>0xffffffff ||
+      typeof result.overlaySupported !== 'boolean' || result.overlaySupported !== (!result.elevated && Number(result.integrityRid)<=8192) ||
+      typeof result.relaunchAvailable !== 'boolean' || !(result.relaunchRefusal===null || typeof result.relaunchRefusal==='string') ||
+      result.relaunchAvailable !== (result.relaunchRefusal===null) || !['inspected','launched','already-unelevated'].includes(String(result.status))) {
+    throw new Error('Native consumer context contradicted this caller or its token');
+  }
+  return result;
+}
+function snapshot(result: Record<string, unknown>): OverlayConsumerExecutionContext {
+  const keys = ['ownerPid','creationTime100ns','executablePath','executableSha256','elevated','integrityRid','sessionId','overlaySupported','relaunchAvailable','relaunchRefusal'];
+  return Object.freeze(Object.fromEntries(keys.map(key=>[key,result[key]]))) as OverlayConsumerExecutionContext;
+}
+async function invoke(config: ReShadeLaunchConfig | undefined, arguments_: readonly string[]): Promise<Record<string, unknown>> {
+  const selected = config ?? createReShadeLaunchConfig();
+  return new Promise((resolve,reject)=>{
+    execFile(selected.addonManagerPath,[...arguments_],{encoding:'utf8',shell:false,windowsHide:true,timeout:30000,maxBuffer:65536},(error,stdout,stderr)=>{
+      if(error){reject(new Error(`Native consumer context request failed: ${stdout.trim() || stderr.trim() || error.message}`));return;}
+      try {
+        if(stderr.trim())throw new Error('Unexpected consumer context stderr');
+        const lines=stdout.trim().split(/\r?\n/u);if(lines.length!==1)throw new Error('Expected one native consumer context record');
+        resolve(validate(JSON.parse(lines[0])));
+      } catch(cause){reject(cause);}
+    });
+  });
+}
+
+/** Reads this calling process's real elevation/integrity and a same-user/session desktop relaunch capability. Never changes a token or starts an app. */
+export async function inspectOverlayConsumerExecutionContext(options: OverlayConsumerContextOptions = {}): Promise<OverlayConsumerExecutionContext> {
+  const result=await invoke(options.config,['--consumer-context',String(process.pid)]);
+  if(result.status!=='inspected' || result.replacementPid!==0 || result.replacementCreationTime100ns!=='0')throw new Error('Unexpected launch during consumer context inspection');
+  return snapshot(result);
+}
+
+/**
+ * Creates only this consumer's own executable using a verified same-user/session
+ * medium desktop parent and fresh user environment. It requests no UAC prompt,
+ * never changes game privileges, and verifies the owned child's image/token
+ * before resuming it. No existing user process thread is resumed or suspended.
+ *
+ * Before calling, suppress the application's persistent administrator startup
+ * option and release its single-instance lock. On failure reacquire that lock;
+ * on `launched` the host may quit the old elevated process. Keep app/session
+ * startup in the replacement fresh; do not transfer elevated rendezvous tokens.
+ * A successful result proves process creation, not application readiness.
+ * A lost or invalid native response does not authorize a blind relaunch retry.
+ */
+export async function launchUnelevatedOverlayConsumer(options: OverlayConsumerRelaunchOptions): Promise<OverlayConsumerRelaunchResult> {
+  const context=options.context;
+  if(context.ownerPid!==process.pid || normalize(context.executablePath)!==normalize(process.execPath) ||
+      !isValidProcessCreationTime100ns(context.creationTime100ns) || !/^[A-F0-9]{64}$/u.test(context.executableSha256)) throw new Error('Relaunch context does not identify this consumer');
+  if(!context.overlaySupported && !context.relaunchAvailable)throw new Error(`Unelevated relaunch is unavailable: ${context.relaunchRefusal}`);
+  const args=options.arguments ?? process.argv.slice(1);
+  if(args.length>256 || args.some(arg=>typeof arg!=='string'||arg.includes('\0')) || args.reduce((length,arg)=>length+arg.length,0)>30000)throw new Error('Invalid consumer launch arguments');
+  const result=await invoke(options.config,['--consumer-relaunch',String(process.pid),context.creationTime100ns,context.executableSha256,...args.flatMap(arg=>['--arg',arg])]);
+  if(result.creationTime100ns!==context.creationTime100ns || result.executableSha256!==context.executableSha256 || result.status==='inspected')throw new Error('Consumer identity changed before relaunch');
+  if(result.status==='already-unelevated'){
+    if(!result.overlaySupported || result.replacementPid!==0 || result.replacementCreationTime100ns!=='0')throw new Error('Unexpected already-unelevated result');
+    return Object.freeze({status:'already-unelevated',context:snapshot(result)});
+  }
+  if(result.overlaySupported || !result.relaunchAvailable || !Number.isSafeInteger(result.replacementPid) || Number(result.replacementPid)<=0 || Number(result.replacementPid)>0xffffffff ||
+      result.replacementPid===process.pid || !isValidProcessCreationTime100ns(result.replacementCreationTime100ns))throw new Error('Invalid verified replacement process');
+  return Object.freeze({status:'launched',context:snapshot(result),replacement:Object.freeze({pid:Number(result.replacementPid),creationTime100ns:result.replacementCreationTime100ns as string})});
+}
diff --git a/libs/electron-game-overlay/src/lib/runtime-payload-store.ts b/libs/electron-game-overlay/src/lib/runtime-payload-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf50337ec1ca0133500217ced5b48575112950c2
--- /dev/null
+++ b/libs/electron-game-overlay/src/lib/runtime-payload-store.ts
@@ -0,0 +1,123 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { chmod, copyFile, link, lstat, mkdir, readFile, realpath, rename, rm, writeFile } from 'node:fs/promises';
+import * as path from 'node:path';
+
+const markerName = '.electron-game-overlay-payload.json';
+const kind = 'electron-game-overlay-payload-v1';
+
+/** Cache snapshots, never package files. The INI and add-on image identities
+ * are private per session. Windows merges hard-linked DLLs into one HMODULE,
+ * so linking participant images would merge independent applications' globals.
+ * Hard links preserve the canonical stage paths required by the native ownership
+ * checks, while storing each immutable file once per verified payload. The SDK
+ * never opens these links for writing or replaces a published cache entry.
+ */
+export async function stageRuntimePayload(
+  sources: ReadonlyMap<string, string>,
+  runsRoot: string,
+  sessionDirectory: string,
+  validate: (files: ReadonlyMap<string, string>) => Promise<unknown>,
+): Promise<void> {
+  const hashes = await Promise.all([...sources].map(async ([name, file]) =>
+    [name, digest(await readFile(file))] as const));
+  const identity = JSON.stringify(hashes);
+  const payloadId = digest(Buffer.from(identity));
+  // A sibling keeps the cache outside session retention and on the same volume.
+  const store = `${runsRoot}.payloads-v1`;
+  await mkdir(store, { recursive: true });
+  await assertOrdinaryDirectory(store);
+  const payload = path.join(store, payloadId);
+  const filesAt = (directory: string) => new Map([...sources.keys()].map(name =>
+    [name, path.join(directory, name)]));
+  const verify = async () => {
+    await assertOrdinaryDirectory(payload);
+    const markerPath = path.join(payload, markerName);
+    await assertOrdinaryFile(markerPath);
+    const marker = JSON.parse(await readFile(markerPath, 'utf8'));
+    if (marker.kind !== kind || marker.payloadId !== payloadId || marker.identity !== identity) {
+      throw new Error('the runtime payload cache ownership does not match its content identity');
+    }
+    await Promise.all(hashes.map(async ([name, hash]) => {
+      const file = path.join(payload, name);
+      await assertOrdinaryFile(file);
+      if (digest(await readFile(file)) !== hash) {
+        throw new Error(`the runtime payload cache hash does not match ${name}`);
+      }
+    }));
+    await validate(filesAt(payload));
+  };
+  try {
+    await lstat(payload);
+  } catch (error) {
+    if (!hasCode(error, 'ENOENT')) throw error;
+    const temporary = path.join(store, `.publishing-${randomUUID()}`);
+    await mkdir(temporary);
+    try {
+      // Wait for all copies before cleanup, including failures.
+      await settled([...sources].map(async ([name, source]) => {
+        const file = path.join(temporary, name);
+        await copyFile(source, file);
+        if (digest(await readFile(file)) !== new Map(hashes).get(name)) {
+          throw new Error(`the runtime source changed while staging ${name}`);
+        }
+      }));
+      await validate(filesAt(temporary));
+      await writeFile(path.join(temporary, markerName), JSON.stringify({ kind, payloadId, identity }), { flag: 'wx' });
+      // Read-only is also enforced by Windows for ordinary write opens. This is
+      // protection against accidental writes, not a boundary against the owner.
+      await settled([...sources.keys(), markerName].map(name => chmod(path.join(temporary, name), 0o444)));
+      try {
+        await rename(temporary, payload);
+      } catch (error) {
+        // Another app may have published the exact same snapshot concurrently.
+        // Never overwrite it: the complete verification below must accept it.
+        if (!hasCode(error, 'EEXIST') && !hasCode(error, 'ENOTEMPTY') && !hasCode(error, 'EPERM')) throw error;
+      }
+    } finally {
+      // Only this call's unpublished UUID directory can be removed here.
+      await rm(temporary, { recursive: true, force: true });
+    }
+  }
+  await verify();
+  await settled([...sources.keys()].map(async name => {
+    const source = path.join(payload, name);
+    const destination = path.join(sessionDirectory, name);
+    if (name === 'ReShade.ini' || name === 'electron_game_overlay.addon64' || name === 'electron_game_overlay.addon32') {
+      await copyFile(source, destination);
+      await chmod(destination, 0o600);
+    } else {
+      // No copy fallback: a filesystem without hard links must fail explicitly
+      // instead of silently recreating the storage amplification.
+      await link(source, destination);
+    }
+  }));
+}
+
+async function settled(work: Promise<unknown>[]): Promise<void> {
+  const results = await Promise.allSettled(work);
+  const failure = results.find((result): result is PromiseRejectedResult => result.status === 'rejected');
+  if (failure) throw failure.reason;
+}
+
+function digest(bytes: Uint8Array): string {
+  return createHash('sha256').update(bytes).digest('hex');
+}
+
+function hasCode(error: unknown, code: string): boolean {
+  return typeof error === 'object' && error !== null && 'code' in error && error.code === code;
+}
+
+async function assertOrdinaryDirectory(directory: string): Promise<void> {
+  const info = await lstat(directory);
+  if (!info.isDirectory() || info.isSymbolicLink() ||
+      (await realpath(directory)).toLowerCase() !== path.resolve(directory).toLowerCase()) {
+    throw new Error('the runtime payload cache must be a canonical ordinary directory');
+  }
+}
+
+async function assertOrdinaryFile(file: string): Promise<void> {
+  const info = await lstat(file);
+  if (!info.isFile() || info.isSymbolicLink()) {
+    throw new Error('the runtime payload cache must contain ordinary files');
+  }
+}
diff --git a/libs/electron-game-overlay/tests/helpers/reconstruct-inspection-injector.cjs b/libs/electron-game-overlay/tests/helpers/reconstruct-inspection-injector.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..cb6b4d39c612ba46d49e51994b609aca2b8125f2
--- /dev/null
+++ b/libs/electron-game-overlay/tests/helpers/reconstruct-inspection-injector.cjs
@@ -0,0 +1,52 @@
+'use strict';
+// Reconstruct production source from the retained, hashed source-text fixtures.
+// No canonical build cache, network, game or graphics build is used.
+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const { spawnSync } = require('node:child_process');
+const runtime = path.resolve(__dirname, '../../../electron-game-overlay-runtime');
+const fixtures = path.join(runtime, 'tests/cooperative-injector-migration/fixtures');
+const sha = text => crypto.createHash('sha256').update(text).digest('hex').toUpperCase();
+const normal = text => text.replace(/^\uFEFF/u, '').replace(/\r\n?/g, '\n');
+
+function reconstruct(directory) {
+  fs.mkdirSync(directory, { recursive: true });
+  if (fs.readdirSync(directory).length) throw new Error('Source reconstruction requires an empty owned directory');
+  const env = { ...process.env, GIT_CEILING_DIRECTORIES: path.dirname(directory) };
+  for (const name of ['GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE']) delete env[name];
+  const run = args => {
+    const result = spawnSync('git', ['-c', 'core.autocrlf=false', ...args], {
+      cwd: directory, encoding: 'utf8', windowsHide: true, timeout: 15000,
+      env,
+    });
+    if (result.status !== 0) throw new Error(result.stderr || result.error?.message || 'Git failed');
+  };
+  // Do not inherit an enclosing repository or an application-provided Git path.
+  run(['init', '--quiet']);
+  const manifest = JSON.parse(fs.readFileSync(path.join(fixtures, 'late-source-cache/manifest.json')));
+  for (const entry of manifest.entries) {
+    if (!entry.base) continue;
+    const text = normal(fs.readFileSync(path.join(fixtures, 'late-source-cache', entry.base.fixture), 'utf8'));
+    if (sha(text) !== entry.base.normalizedSha256) throw new Error('Frozen fixture hash mismatch: ' + entry.path);
+    const file = path.join(directory, entry.path);
+    fs.mkdirSync(path.dirname(file), { recursive: true }); fs.writeFileSync(file, text);
+  }
+  const injector = path.join(directory, 'tools/injector.cpp');
+  const pre = normal(fs.readFileSync(path.join(fixtures, 'pre-cooperative-injector.cpp.txt'), 'utf8'));
+  if (sha(pre) !== 'E6EB9FFC0431EE5703E44EB757819AB946E2E8B0335A6D39186D0B32776DE359') throw new Error('Pre-cooperative fixture hash mismatch');
+  const cmake = fs.readFileSync(path.join(runtime, 'CMakeLists.txt'), 'utf8');
+  const addonId = cmake.match(/set\(ELECTRON_GAME_OVERLAY_ADDON_BUILD_ID\s+"([0-9A-F]+)"/)?.[1];
+  fs.writeFileSync(injector, pre.replace('12EE788081A34E00B10862242DF38893', addonId));
+  for (const name of ['injector-cooperative-members', 'owned-late-d3d11', 'injector-first-host-result',
+    'injector-preloaded-addon', 'injector-preloaded-first-host', 'injector-preload-long-path',
+    'owned-late-d3d11-adapter-ready-long-path', 'injector-initial-inspection-recovery',
+    'injector-shared-addon-directory', 'owned-late-d3d11-addon-failure-isolation', 'injector-inspection-context']) {
+    run(['apply', '--whitespace=nowarn', path.join(runtime, 'patches', `reshade-${name}.patch`)]);
+  }
+  const expected = cmake.match(/set\(RESHAPE_INSPECTION_CONTEXT_INJECTOR_CONTENT_SHA256\s+"([0-9A-F]+)"/)?.[1];
+  if (sha(normal(fs.readFileSync(injector, 'utf8'))) !== expected) throw new Error('Reconstructed production injector hash mismatch');
+  return injector;
+}
+module.exports = { reconstruct };
+if (require.main === module) console.log(reconstruct(path.resolve(process.argv[2])));
diff --git a/libs/electron-game-overlay/tests/overlay-consumer-context.test.cjs b/libs/electron-game-overlay/tests/overlay-consumer-context.test.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..5bc481d9f7378cde74b02af7449f43e768a20b1b
--- /dev/null
+++ b/libs/electron-game-overlay/tests/overlay-consumer-context.test.cjs
@@ -0,0 +1,62 @@
+'use strict';
+const test=require('node:test');
+const assert=require('node:assert/strict');
+const cp=require('node:child_process');
+const {inspectOverlayConsumerExecutionContext:inspect,launchUnelevatedOverlayConsumer:launch}=require('../dist/lib/overlay-consumer-context.js');
+const config={addonManagerPath:'C:\\verified-runtime\\manager.exe'};
+function record(extra={}) { return {schemaVersion:1,kind:'electron-game-overlay-consumer-context',ownerPid:process.pid,creationTime100ns:'134387369353549747',executablePath:process.execPath,executableSha256:'A'.repeat(64),elevated:true,integrityRid:12288,sessionId:1,overlaySupported:false,relaunchAvailable:true,relaunchRefusal:null,status:'inspected',replacementPid:0,replacementCreationTime100ns:'0',...extra}; }
+function stub(t,responses) {
+  const calls=[],original=cp.execFile;
+  cp.execFile=(file,args,options,callback)=>{
+    calls.push({file,args,options});
+    const response=responses.shift();assert.ok(response,'Unexpected helper invocation');
+    queueMicrotask(()=>callback(response.error??null,response.stdout??JSON.stringify(response.record),response.stderr??''));
+  };
+  t.after(()=>{cp.execFile=original;});return calls;
+}
+test('consumer inspection is read-only, hidden, shell-free, and binds the actual caller',async t=>{
+  const calls=stub(t,[{record:record()}]);const context=await inspect({config});
+  assert.equal(context.elevated,true);assert.equal(Object.isFrozen(context),true);
+  assert.deepEqual(calls[0].args,['--consumer-context',String(process.pid)]);
+  assert.equal(calls[0].options.shell,false);assert.equal(calls[0].options.windowsHide,true);
+  assert.equal(calls.length,1);
+});
+test('elevated consumer launch binds inspected birth and image, preserves literal arguments, and returns verified child identity',async t=>{
+  const calls=stub(t,[{record:record()},{record:record({status:'launched',replacementPid:process.pid+1,replacementCreationTime100ns:'134387369353549748'})}]);
+  const context=await inspect({config});const args=['C:\\dev app\\main.js','','quote"here','trailing\\','$(literal)','--flag'];
+  const result=await launch({config,context,arguments:args});
+  assert.equal(result.status,'launched');assert.equal(result.replacement.pid,process.pid+1);
