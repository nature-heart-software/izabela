{
  "extends": "nx/presets/npm.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/dist-electron",
        "{projectRoot}/dist_electron"
      ],
      "cache": true
    },
    "build:prod": {
      "dependsOn": ["^build:prod"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/dist-electron",
        "{projectRoot}/dist_electron"
      ]
    },
    "dev": {
      "dependsOn": ["^build"]
    }
  },
  "useInferencePlugins": false
}
