{
  "name": "izabela-next",
  "description": "Your speech assistant.",
  "version": "6.6.6",
  "author": "Nature Heart Software",
  "dependencies": {
    "@nut-tree-fork/libnut-win32": "2.7.5",
    "@packages/electron-game-overlay": "workspace:*",
    "@packages/native-keymap": "workspace:*",
    "@packages/process-watcher": "workspace:*",
    "@packages/win-mouse": "workspace:*",
    "bindings": "1.5.0",
    "electron-postman": "workspace:*",
    "file-uri-to-path": "1.0.0",
    "forcefocus": "^1.1.0",
    "koffi": "^2.9.1",
    "node-abi": "^4.17.0",
    "node-global-key-listener": "^0.1.1",
    "node-record-lpcm16": "workspace:*",
    "win-control": "workspace:*",
    "windows-tlist": "workspace:*",
    "wql-process-monitor": "3.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@apps/app-server": "workspace:*",
    "@aws-sdk/client-transcribe-streaming": "^3.943.0",
    "@aws-sdk/client-translate": "^3.943.0",
    "@aws-sdk/credential-providers": "^3.943.0",
    "@azure-rest/ai-translation-text": "^1.0.1",
    "@elevenlabs/elevenlabs-js": "^2.36.0",
    "@nut-tree-fork/libnut": "4.2.6",
    "@nut-tree-fork/nut-js": "^4.2.1",
    "@nut-tree-fork/shared": "4.2.6",
    "@packages/animalese": "workspace:*",
    "@packages/electron-bridger": "workspace:*",
    "@packages/electron-pinia": "workspace:*",
    "@packages/toolbox": "workspace:*",
    "@packages/ui": "workspace:*",
    "@types/wav": "^1.0.4",
    "@vitalets/google-translate-api": "^9.2.1",
    "electron": "39.1.0",
    "ibm-watson": "^12.1.1",
    "jimp": "0.22.10",
    "micromatch": "^4.0.5",
    "microsoft-cognitiveservices-speech-sdk": "^1.47.0",
    "node-abort-controller": "3.1.1",
    "openai": "^6.22.0",
    "sudo-prompt": "^9.2.1",
    "systeminformation": "^5.17.3"
  },
  "main": "dist-electron/background.js",
  "private": true,
  "productName": "Izabela Next",
  "repository": "https://github.com/nature-heart-software/izabela",
  "scripts": {
    "build": "vite build && pnpm run rebuild && pnpm run electron:build",
    "build:prod": "vue-tsc && pnpm run build",
    "dev": "vite",
    "electron:build": "electron-builder --config electron-builder.config.js --publish never",
    "generate:app-icon": "pnpm dlx electron-icon-builder --input=./assets/app-icon.png --output=./build --flatten && pnpm dlx electron-icon-builder --input=./assets/app-icon.png --output=./public --flatten",
    "lint": "vue-tsc",
    "preview": "vite preview",
    "rebuild": "electron-rebuild -f -w forcefocus"
  }
}
