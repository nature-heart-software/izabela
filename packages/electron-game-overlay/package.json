{
  "name": "@packages/electron-game-overlay",
  "version": "0.0.0",
  "devDependencies": {
    "cmake-js": "^7.4.0",
    "node-addon-api": "^8.5.0"
  },
  "files": [
    "./dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "private": true,
  "scripts": {
    "build": "vite build && node ./bin/build",
    "test:types": "vite build && node tests/prepare-types.mjs && tsc -p tests/tsconfig.json"
  },
  "source": "src/main.ts",
  "type": "module",
  "types": "./dist/main.d.ts",
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "inputs": [
          "nativeBuild"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
