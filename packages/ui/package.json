{
  "name": "@packages/ui",
  "version": "0.0.0",
  "dependencies": {
    "@packages/design-tokens": "workspace:*",
    "@packages/icons": "workspace:*",
    "@packages/vite-plugin-generate-exports": "workspace:*",
    "@zag-js/interact-outside": "0.71.0",
    "csstype": "^3.2.3",
    "tippy.js": "^6.3.7",
    "@ark-ui/vue": "^3.11.0"
  },
  "files": [
    "./dist"
  ],
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "private": true,
  "scripts": {
    "test:browser": "node tests/browser.mjs",
    "test:types": "pnpm run build && vue-tsc --noEmit -p tests/tsconfig.json",
    "build": "pnpm run panda:prepare && vite build",
    "build-storybook": "pnpm run panda:prepare && storybook build",
    "build:prod": "pnpm run panda:prepare && vue-tsc && vite build",
    "dev": "pnpm run panda:prepare && vite build --watch --mode development",
    "storybook": "pnpm run panda:prepare && storybook dev -p 6006",
    "panda:prepare": "panda codegen && panda cssgen",
    "prepare": "pnpm run panda:prepare"
  },
  "type": "module",
  "types": "./dist/main.d.ts",
  "devDependencies": {
    "@pandacss/dev": "1.12.1"
  }
}
